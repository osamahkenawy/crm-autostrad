# Settings for `npm run dev:live`: the customer-systems connector on, pointed at the stand-in systems
# (scripts/mock-customer-api.mjs on port 4010). Not secrets: the stand-in accepts these fake keys.
# Loaded with node --env-file, so it works on Windows too. Real environment variables win over this file.
HELPDESK_ACCOUNT_SOURCE=api
CUSTOMER_SYSTEMS_CONFIG=config/customer-systems.example.json
ORION_BASE_URL=http://127.0.0.1:4010/v1
CNR_BASE_URL=http://127.0.0.1:4010/v1
ORION_API_KEY=dev-mock-key
CNR_API_KEY=dev-mock-key
