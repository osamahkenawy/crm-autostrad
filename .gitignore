# dependencies and build output
node_modules/
dist/
.vite/

# databases (the demo one is regenerated by `npm run seed`; real ones are backed up with `npm --prefix server run backup`)
*.db
*.db-journal
*.db-wal
*.db-shm
server/data/backups/

# secrets: server/.env holds the real keys and is never committed (server/.env.example is the template)
.env
.env.*
!.env.example

# local tooling and leftovers
.DS_Store
*.log
.claude/

# a screenshot deliverable, not source
*.pdf
